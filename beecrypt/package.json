{
  "name": "beecrypt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BeeCrypt — blockchain-ready honey traceability frontend (SIH 2026, PS 26021)",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "db:clean": "node server/db/clean.js",
    "build": "vite build",
    "test": "node --test tests/remediation.test.js tests/security.test.js tests/camera.test.js tests/sensor.test.js",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "build:mobile": "vite build && cap sync",
    "build:apk:debug": "vite build && cap sync && cd android && ./gradlew assembleDebug",
    "build:apk:release": "vite build && cap sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "lucide-react": "^0.383.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
