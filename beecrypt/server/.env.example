# Server Port
PORT=3001

# Neon Cloud PostgreSQL Connection String
# Example: postgresql://username:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/beecrypt?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-host.us-east-2.aws.neon.tech/beecrypt?sslmode=require

# JWT Configuration
# REQUIRED IN PRODUCTION: Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server will refuse to start in production if this is missing or uses the placeholder.
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS and Cookie credentials)
FRONTEND_URL=http://localhost:5173

# ESP32-CAM integration
ESP32_IP=http://10.131.229.39
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ESP32CAM
# Shared key sent by the ESP32 firmware as X-Camera-Device-Key.
CAMERA_DEVICE_KEY=replace_with_a_device_key
# Shared key sent by the ESP32 DevKit firmware as X-Sensor-Device-Key
SENSOR_DEVICE_KEY=replace_with_sensor_device_key
MONGODB_SENSOR_COLLECTION=READINGS

# Application Environment
# Set to 'production' on live servers. The server enforces stricter security in production mode.
NODE_ENV=development

# KVIC Approval: First-Login Setup Token TTL (in minutes)
# How long the one-time password-setup token is valid after KVIC approves an application.
SETUP_TOKEN_TTL_MINUTES=60
